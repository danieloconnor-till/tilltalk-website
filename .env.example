# All real values live in Vercel (project settings → Environment Variables).
# Pull locally with `npx vercel env pull .env.local`. This file documents
# what is needed; do NOT commit real values.

# Meta App Review — Test App OAuth (sandbox)
# Real values go in Vercel env vars only.
# META_REVIEW_APP_ID     = Test App 834278479749382 ID
# META_REVIEW_APP_SECRET = Test App secret from developers.facebook.com → App settings → Basic
# Daniel sets these manually in Vercel.
META_REVIEW_APP_ID=
META_REVIEW_APP_SECRET=
META_REVIEW_REDIRECT_URI=https://tilltalk.ie/review/meta-bk2xp9/callback

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_OAUTH_STATE_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# ── Meta connect flow (/connect/meta) ──
# Reuses META_REVIEW_APP_ID / META_REVIEW_APP_SECRET (same Meta app 1373116251311238).
# META_CONNECT_REDIRECT_URI     = OAuth callback registered on the app for the connect flow
META_CONNECT_REDIRECT_URI=https://tilltalk.ie/connect/meta/callback
# TILLTALK1_BASE_URL            = tilltalk1 base URL for the server-side token deposit
TILLTALK1_BASE_URL=https://tilltalk1-production.up.railway.app
# TILLTALK1_ONBOARDING_KEY      = shared secret; must equal tilltalk1 ONBOARDING_API_KEY (never commit the value)
TILLTALK1_ONBOARDING_KEY=
